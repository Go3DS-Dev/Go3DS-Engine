#!/usr/bin/env python
import os
import subprocess
Import("env")

common_3ds = [
    "os_3ds.cpp",
    "platform_thread.cpp",
    "servers/rendering/rasterizer_3ds.cpp"
]

common_3ds += SConscript("filesystem/SCsub")
prog = env.add_program("#bin/godot", ["godot_3ds.cpp"] + common_3ds)

def generate_3dsx(target, source, env):
    elf = str(prog[0])
    tools = os.path.join(env["devkitpro"], "tools", "bin")
    subprocess.run([env["STRIP"], "-s", "-R", ".comment", "-R", ".gnu.version", "--strip-unneeded", elf], check=True)
    subprocess.run([os.path.join(tools, "smdhtool"), "--create", "Godot Sprite2D test",
                    "Minimal Citro2D canvas backend", "Godot 3DS contributors",
                    "platform/3ds/icon.png", "platform/3ds/godot.smdh"], check=True)
    subprocess.run([os.path.join(tools, "3dsxtool"), "--romfs=platform/3ds/romfs",
                    "--smdh=platform/3ds/godot.smdh", elf, elf + ".3dsx"], check=True)
    return 0



generate_3dsx_command = env.Command("generate_3dsx", [prog],generate_3dsx )
command = env.AlwaysBuild(generate_3dsx_command)
env.Depends(command, [prog])